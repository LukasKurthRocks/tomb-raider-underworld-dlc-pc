    "removeOtherAsis":  true,
    "trulink":  {
                    "port":  9265,
                    "waitSeconds":  300
                },
    "tests":  [
                  {
                      "kind":  "step",
                      "n":  1,
                      "id":  "-",
                      "text":  "Main menu: open the DLC mission menu at once (before the attract timer starts DLC 2)"
                  },
                  {
                      "kind":  "check",
                      "id":  "dlc1-menu",
                      "text":  "Mission menu shows Unter der Asche / Beneath the Ashes, title and text in the game language"
                  },
                  {
                      "kind":  "step",
                      "n":  2,
                      "id":  "-",
                      "text":  "Start DLC 1 from the mission menu (not level.load - it skips the intro)"
                  },
                  {
                      "kind":  "check",
                      "id":  "dlc1-load-title",
                      "text":  "Loading screen: title UNTER DER ASCHE above the line, description directly below the line (not on it)"
                  },
                  {
                      "kind":  "check",
                      "id":  "dlc1-cutscene",
                      "text":  "Intro plays to its end in the game language; skip-cinematic bar as on the Xbox"
                  },
                  {
                      "kind":  "step",
                      "n":  3,
                      "id":  "-",
                      "text":  "Move Lara; walk to the first health-pack hint and the grapple points"
                  },
                  {
                      "kind":  "check",
                      "id":  "dlc1-lara",
                      "text":  "Lara in her normal DLC 1 outfit (no doppelganger, no DLC 2 costume swap)"
                  },
                  {
                      "kind":  "check",
                      "id":  "dlc1-hint",
                      "text":  "Health-pack hint top right in a faint dark box, no Press A line, no pause"
                  },
                  {
                      "kind":  "check",
                      "id":  "dlc1-grapple",
                      "text":  "Grapple ring rusty copper with highlights, holder without yellow / olive highlight; shiny copper in the camera zoom"
                  },
                  {
                      "kind":  "step",
                      "n":  4,
                      "id":  "-",
                      "text":  "Hold RB and LB a few seconds each"
                  },
                  {
                      "kind":  "check",
                      "id":  "dlc1-no-shadow",
                      "text":  "RB / LB: normal DLC 1 behaviour - no slow motion from us, no shadow meter in the HUD"
                  },
                  {
                      "kind":  "check",
                      "id":  "dlc1-bridge",
                      "text":  "Adrenaline bridge (padshock dlc1_adren_bridge): crossing it does not crash"
                  },
                  {
                      "kind":  "step",
                      "n":  5,
                      "id":  "-",
                      "text":  "Take a hit / fall, then jump to death"
                  },
                  {
                      "kind":  "check",
                      "id":  "dlc1-death",
                      "text":  "Health drops; after the death Lara reappears at the checkpoint, no crash"
                  },
                  {
                      "kind":  "check",
                      "id":  "dlc1-treasure",
                      "text":  "Treasure room (dlc_treasureroom, achievement fix): entering it and its trigger do not crash (level.load allowed here)"
                  },
                  {
                      "kind":  "check",
                      "id":  "dlc1-outfits",
                      "text":  "Outfit list: descriptions as on the Xbox (4 lines); fewer entries = known gap (costume packs)"
                  },
                  {
                      "kind":  "step",
                      "n":  6,
                      "id":  "-",
                      "text":  "Mark the checks (A ok, X fail, Y skip), then end the game normally"
                  },
                  {
                      "kind":  "check",
                      "id":  "no-crash",
                      "text":  "No crash, freeze or box during the whole run"
                  }
              ],
    "expects":  [
                    {
                        "id":  "doppel-ids",
                        "file":  "TruDoppelganger.log",
                        "mode":  "present",
                        "pattern":  "title-update ids registered: 13 conditions, 9 activities, 8 states",
                        "text":  "TruDoppelganger registered all title-update ids (13 conditions, 9 activities, 8 states)"
                    },
                    {
                        "id":  "rv-no-mismatch",
                        "file":  "TruRockVein.log",
                        "mode":  "absent",
                        "pattern":  "does not match",
                        "text":  "TruRockVein found every code site it patches (no \u0027does not match\u0027)"
                    },
                    {
                        "id":  "sp-no-mismatch",
                        "file":  "TruShadowPower.log",
                        "mode":  "absent",
                        "pattern":  "does not match",
                        "text":  "TruShadowPower found every code site it patches (no \u0027does not match\u0027)"
                    },
                    {
                        "id":  "cdb-d3dfail",
                        "file":  "cdb.log",
                        "mode":  "absent",
                        "pattern":  "^\\s*D3DFAIL\\s*$",
                        "text":  "No D3D error handler call (D3DFAIL marker)",
                        "optional":  false
                    },
                    {
                        "id":  "cdb-av",
