                        "mode":  "absent",
                        "pattern":  "^\\s*AV2NDCHANCE\\s*$",
                        "text":  "No second-chance access violation (AV2NDCHANCE marker)",
                        "optional":  false
                    },
                    {
                        "id":  "cdb-fastfail",
                        "file":  "cdb.log",
                        "mode":  "absent",
                        "pattern":  "^\\s*FASTFAIL\\s*$",
                        "text":  "No fast fail (FASTFAIL marker)",
                        "optional":  false
                    },
                    {
                        "id":  "cdb-msgbox",
                        "file":  "cdb.log",
                        "mode":  "absent",
                        "pattern":  "^\\s*MESSAGEBOX_[AW]\\s*$",
                        "text":  "No message box (MESSAGEBOX_A / MESSAGEBOX_W marker)",
                        "optional":  false
                    },
                    {
                        "id":  "dlc1-no-swap",
                        "file":  "TruDlc2Player.log",
                        "mode":  "absent",
                        "pattern":  "costume \"lara_doppelganger\" -\u003e doppelganger_casual",
                        "text":  "No doppelganger costume swap in DLC 1"
                    },
                    {
                        "id":  "sp-no-on",
                        "file":  "TruShadowPower.log",
                        "mode":  "absent",
                        "pattern":  "shadow power ON \\(meter",
                        "text":  "The shadow power never started (DLC 2 plugins inactive outside DLC 2; LogLevel 2)"
                    },
                    {
                        "id":  "guard-faults",
                        "file":  "TruGuard.log",
                        "mode":  "absent",
                        "pattern":  "TRUGUARD_DETAIL",
                        "text":  "No first-chance fault in the game code recorded by TruGuard"
                    }
                ]
