    "tests":  [
                  {
                      "kind":  "step",
                      "n":  1,
                      "id":  "-",
                      "text":  "Hauptmenue abwarten, bis es ganz da ist (kein AutoStart in diesem Paket: DLC 1 startet ueber das Missionsmenue) | NEU (TruMenu 0.10.5): Ring-Ebene Claude -\u003e Jetzt / Gut / Fehler / Grafik komisch / Ton komisch / Ruckler / Haenger setzt eine Marke fuer Claude (Log-Zeile + Bild, Ring schliesst); F11 = Jetzt"
                  },
                  {
                      "kind":  "step",
                      "n":  2,
                      "id":  "-",
                      "text":  "Zusatzinhalte -\u003e Beneath the Ashes / Unter der Asche -\u003e Mission spielen: normales Outfit, Waffe egal; Intro laufen lassen oder ueberspringen"
                  },
                  {
                      "kind":  "step",
                      "n":  3,
                      "id":  "-",
                      "text":  "Im Level: Ring oeffnen (L3+R3 0,5 s halten oder F9) -\u003e Spieler -\u003e Helfer -\u003e Saves sichern; B, B"
                  },
                  {
                      "kind":  "check",
                      "id":  "saves-backup",
                      "text":  "TruMenu.log \"saves: backup \u003cZeit\u003e: n file(s) copied, 0 failed\"; die Sicherung steht unter backups"
                  },
                  {
                      "kind":  "step",
                      "n":  4,
                      "id":  "-",
                      "text":  "Ring -\u003e Cheats -\u003e Gott-Modus voll (ausser Sofort-Tod); dann Ring -\u003e Cheats -\u003e Gegner-Leben zeigen (kann im Verkaufsspiel nichts zeigen - dann egal)"
                  },
                  {
                      "kind":  "step",
                      "n":  5,
                      "id":  "-",
                      "text":  "Ring -\u003e Tests -\u003e Rundgang -\u003e DLC 1 -\u003e Laden dlc_dungeon; warten bis Lara steht; dann Ring -\u003e Tests -\u003e Rundgang -\u003e DLC 1 -\u003e 25 (Kerker, Dragon-Slider)"
                  },
                  {
                      "kind":  "step",
                      "n":  6,
                      "id":  "-",
                      "text":  "Von Stopp 25 etwa 60 m weit gehen, bis Laras x-Koordinate von etwa -8200 auf etwa -14000 sinkt (TruMenu-Positionsanzeige), gleiche Bodenhoehe wie der Dragon-Slider: dort liegen laut Daten zwei Ritter-Thralls (Intros 10661 / 10662, nicht live geprueft), zwei weitere eine Etage tiefer (9947 / 12243). Kein Gegner zu finden: Ring -\u003e Claude -\u003e Fehler, dann normal weiterspielen bis zum ersten Ritter"
                  },
                  {
                      "kind":  "step",
                      "n":  7,
                      "id":  "-",
                      "text":  "NUR Pistolen (Standardwaffe; Befehlszeile weapon.has wp_handgun, fehlt sie: weapon.give wp_handgun). Ritter 1: beim ERSTEN Schuss F11, Schuesse mitzaehlen, beim Fallen / Sterben wieder F11; steht er wieder auf: noch einmal F11"
                  },
                  {
                      "kind":  "check",
                      "id":  "pistol-enemy-1",
                      "text":  "Ritter 1: Zahl der Schuesse bis zum Fall in die Notiz; steht er wieder auf (ja / nein)? Die Zeit liefert der Abstand der zwei F11-Marken im TruMenu.log"
                  },
                  {
                      "kind":  "check",
                      "id":  "pistol-hit-effect",
                      "text":  "Treffer-Effekt: normale Kugel-Treffer (Funken / Staub / Blut) oder etwas anderes (Blasen, Schrot-Effekt, gar nichts)? Kurz beschreiben"
                  },
                  {
                      "kind":  "step",
                      "n":  8,
                      "id":  "-",
                      "text":  "Ritter 2 und 3 genauso: nur Pistolen, F11 beim ersten Schuss und beim Fall, Schuesse zaehlen"
                  },
                  {
                      "kind":  "check",
                      "id":  "pistol-enemy-3",
                      "text":  "Ritter 2 und 3: Schuesse bis zum Fall je Ritter in die Notiz (alle drei Zahlen; Vergleich paket17a = B138-Kugel mit paket17b = PC-Original)"
                  },
                  {
                      "kind":  "check",
                      "id":  "pistol-no-crash",
                      "text":  "Kein Absturz, Haenger oder Treiber-Meldung beim Schiessen, Treffen und Sterben der Ritter"
                  },
                  {
                      "kind":  "step",
                      "n":  9,
                      "id":  "-",
                      "text":  "Checks markieren: Ring -\u003e Tests -\u003e TO TEST, Zeile waehlen, Hinweis, dann OK / Erledigt (oder X Fehler, Y ueberspringen)"
                  },
                  {
                      "kind":  "step",
                      "n":  10,
                      "id":  "-",
                      "text":  "LETZTER SCHRITT, beendet das Spiel: Ring oberste Ebene Spiel beenden, A (rot), innerhalb 10 s noch einmal A"
                  },
                  {
                      "kind":  "check",
                      "id":  "radial-quit-confirm",
                      "text":  "Das zweite A hat das Spiel beendet; Zusammenfassung: beendet ueber TruMenu game.quit (kein Absturz); Log game.quit (radial sector): confirmed"
                  }
              ],
