    "tests":  [
                  {
                      "kind":  "toggle",
                      "id":  "dlc2-costume",
                      "target":  "ini:TruDlc2Player:Dlc2Player:Costume",
                      "initial":  "on",
                      "text":  "TruDlc2Player Costume (lara_doppelganger -\u003e doppelganger_casual at level load)"
                  },
                  {
                      "kind":  "toggle",
                      "id":  "sp-states",
                      "target":  "ini:TruShadowPower:States:Enabled",
                      "initial":  "on",
                      "text":  "TruShadowPower [States] Enabled (TU states 243 / 245 / 1018)"
                  },
                  {
                      "kind":  "toggle",
                      "id":  "sp-conditions",
                      "target":  "ini:TruShadowPower:Conditions:Enabled",
                      "initial":  "on",
                      "text":  "TruShadowPower [Conditions] Enabled (meter conditions 1049-1056)"
                  },
                  {
                      "kind":  "step",
                      "n":  1,
                      "id":  "-",
                      "text":  "Wait in the main menu until it is shown completely"
                  },
                  {
                      "kind":  "step",
                      "n":  2,
                      "id":  "-",
                      "text":  "Press L3 + R3: TruMenu opens on TO TEST; check the three switches (a change needs a restart)"
                  },
                  {
                      "kind":  "step",
                      "n":  3,
                      "id":  "-",
                      "text":  "Close the menu and WAIT for the automatic direct start into DLC 2. Do not use level.load"
                  },
                  {
                      "kind":  "step",
                      "n":  4,
                      "id":  "-",
                      "text":  "Let the intro cutscene play to its end (do not skip it)"
                  },
                  {
                      "kind":  "check",
                      "id":  "cutscene",
                      "text":  "The intro cutscene played (picture and sound, no hang)"
                  },
                  {
                      "kind":  "step",
                      "n":  5,
                      "id":  "-",
                      "text":  "Move Lara: walk, run, turn the camera"
                  },
                  {
                      "kind":  "check",
                      "id":  "doppel-look",
                      "text":  "Doppelganger outfit as on the Xbox: dark red hair, black top / trousers / gloves, natural face and arm skin (no white, cyan, green or red / white parts)"
                  },
                  {
                      "kind":  "check",
                      "id":  "arms-gloves",
                      "text":  "arms: pale skin with faint veins, gloves black (Xbox reference _05)"
                  },
                  {
                      "kind":  "check",
                      "id":  "d3d-box",
                      "text":  "No D3D error box (D3DERR_INVALIDCALL 0x8876086C) after the load"
                  },
                  {
                      "kind":  "step",
                      "n":  6,
                      "id":  "-",
                      "text":  "Walk to the rock channel (Felsrinne) without the shadow power: jump against it - it should behave like a normal wall (no ledge there)"
                  },
                  {
                      "kind":  "check",
                      "id":  "wall-normal",
                      "text":  "Rock channel without shadow power: normal wall behaviour (jump against / off), no fall through, no crash"
                  },
                  {
                      "kind":  "check",
                      "id":  "vein-look",
                      "text":  "Rock vein strip at the first rock channel: bright, raised stone blocks with a dark centre joint (Xbox look), not a dark flat strip; no black / flickering patches on the wall"
                  },
                  {
                      "kind":  "step",
                      "n":  7,
                      "id":  "-",
                      "text":  "Hold RB for a few seconds: slow motion, the yellow silhouette drains"
                  },
                  {
                      "kind":  "step",
                      "n":  8,
                      "id":  "-",
                      "text":  "Release RB: normal speed again, the yellow silhouette refills"
                  },
                  {
                      "kind":  "check",
                      "id":  "shadow-power",
                      "text":  "Shadow power: slow motion while RB is held, meter drains and refills"
                  },
                  {
                      "kind":  "step",
                      "n":  9,
                      "id":  "-",
                      "text":  "Go to the rock channel (Felsrinne) wall, hold RB and press A at the wall"
                  },
                  {
                      "kind":  "check",
                      "id":  "wall-run",
                      "text":  "Wall run: Lara runs along the wall, no crash, no box"
                  },
                  {
                      "kind":  "step",
                      "n":  10,
                      "id":  "-",
                      "text":  "Wall run again: once jump off the wall (A with a direction), once release RB, once run until she comes down near the floor"
                  },
                  {
                      "kind":  "check",
                      "id":  "wall-exit",
                      "text":  "Leaving the wall (jump off / RB released / near the floor): Lara lands or falls normally, no crash, no teleport"
                  },
                  {
                      "kind":  "step",
                      "n":  11,
                      "id":  "-",
                      "text":  "Take a hit or fall from a small height: the health bar drops"
                  },
                  {
                      "kind":  "check",
                      "id":  "no-crash",
                      "text":  "No crash, freeze or box during the whole run (incl. hit / fall)"
                  },
                  {
                      "kind":  "step",
                      "n":  12,
                      "id":  "-",
                      "text":  "Rock channel: wall run (RB + A), once jump up from the wall to the ledge above (X); then let Lara die (fall, or time.scale 0.5 + jump to death) and let the game reload. Repeat 3 times"
                  },
                  {
                      "kind":  "check",
                      "id":  "death-no-crash",
                      "text":  "Wall run, jump up, death and reload (3 times): no crash, no freeze (50b / 50d / 50d_nolook / 50d_nojump crashed here in the heap free tru+0x1982b6 / +0x1982ef)"
                  },
                  {
                      "kind":  "step",
                      "n":  13,
                      "id":  "-",
                      "text":  "Play on for a few minutes after the last reload (walk, wall run, RB slow motion)"
                  },
                  {
                      "kind":  "step",
                      "n":  14,
                      "id":  "-",
                      "text":  "After the rock channel: the wall-slide section - slide down the wall with LB held (shadow power) several times; play on to the goo machine if possible"
                  },
                  {
                      "kind":  "check",
                      "id":  "wallslide-no-crash",
                      "text":  "Wall slide with LB held: no crash (50e crashed there at tru+0x14df8f, effect node id 0x495f0000)"
                  },
                  {
                      "kind":  "step",
                      "n":  15,
                      "id":  "-",
                      "text":  "Normal deaths: jump from the upper part of a wall down to the floor (fall death), also a fall death without the power and one after a long shimmy along the wall; let the game reload each time (3 times)"
                  },
                  {
                      "kind":  "check",
                      "id":  "fall-death-no-crash",
                      "text":  "Normal death (fall) and reload: no crash (50f crashed at tru+0x14df84 after a fall death, chart parameter 1112 id 0x04900000)"
                  },
                  {
                      "kind":  "step",
                      "n":  16,
                      "id":  "-",
                      "text":  "Go on from dlc_level2_start into dlc_yggdrasil_hall01 (dark corridor with red glowing runes) and walk on for a few minutes; let thralls appear / fight them if they do"
                  },
                  {
                      "kind":  "check",
                      "id":  "yggdrasil-hall01-no-crash",
                      "text":  "Enter dlc_yggdrasil_hall01 and walk on: no crash (50h crashed 3.7 s after entering, tru+0x14df84 eax 0x00652000, viking thrall anim event)"
                  },
                  {
                      "kind":  "step",
                      "n":  17,
                      "id":  "-",
                      "text":  "Mark the checks (A ok, X fail, Y skip), then end the game normally"
                  },
                  {
                      "kind":  "step",
                      "n":  90,
                      "id":  "-",
                      "text":  "Menu 0.7.1: open TruMenu in the level, type wasd into the command bar while Lara stands; hold w and open the menu"
                  },
                  {
                      "kind":  "check",
                      "id":  "menu-block-input",
                      "text":  "Lara does not move while the menu is open (typing / held key)"
                  },
                  {
                      "kind":  "check",
                      "id":  "menu-esc",
                      "text":  "Esc in the menu does not open the game pause menu"
                  },
                  {
                      "kind":  "check",
                      "id":  "menu-b-twice",
                      "text":  "B with the on-screen keyboard open: first B closes the keyboard, second B the menu"
                  },
                  {
                      "kind":  "check",
                      "id":  "menu-unit-log",
                      "text":  "log.overlay on: room names (unit: ... (was ...)) appear while walking through DLC 2"
                  }
              ],
