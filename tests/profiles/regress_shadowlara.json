  "tests": [
    { "kind": "toggle", "id": "dlc2-costume", "target": "ini:TruDlc2Player:Dlc2Player:Costume", "initial": "on",
      "text": "TruDlc2Player Costume (lara_doppelganger -> doppelganger_casual at level load)" },
    { "kind": "toggle", "id": "sp-states", "target": "ini:TruShadowPower:States:Enabled", "initial": "on",
      "text": "TruShadowPower [States] Enabled (TU states 243 / 245 / 1018)" },
    { "kind": "toggle", "id": "sp-conditions", "target": "ini:TruShadowPower:Conditions:Enabled", "initial": "on",
      "text": "TruShadowPower [Conditions] Enabled (meter conditions 1049-1056)" },
    { "kind": "step", "n": 1, "id": "-", "text": "Wait in the main menu until it is shown completely" },
    { "kind": "step", "n": 2, "id": "-", "text": "Press L3 + R3: TruMenu opens on TO TEST; check the three switches (a change needs a restart)" },
    { "kind": "step", "n": 3, "id": "-", "text": "Close the menu and WAIT for the automatic direct start into DLC 2. Do not use level.load" },
    { "kind": "step", "n": 4, "id": "-", "text": "Let the intro cutscene play to its end (do not skip it)" },
    { "kind": "check", "id": "cutscene", "text": "The intro cutscene played (picture and sound, no hang)" },
    { "kind": "step", "n": 5, "id": "-", "text": "Move Lara: walk, run, turn the camera" },
    { "kind": "check", "id": "doppel-look", "text": "Lara looks like the doppelganger (doppelganger_casual, no grey / wrong textures)" },
    { "kind": "check", "id": "d3d-box", "text": "No D3D error box (D3DERR_INVALIDCALL 0x8876086C) after the load" },
    { "kind": "step", "n": 6, "id": "-", "text": "Walk to the rock channel (Felsrinne) without the shadow power: jump against it - it should behave like a normal wall (no ledge there)" },
    { "kind": "check", "id": "wall-normal", "text": "Rock channel without shadow power: normal wall behaviour (jump against / off), no fall through, no crash" },
    { "kind": "step", "n": 7, "id": "-", "text": "Hold RB for a few seconds: slow motion, the yellow silhouette drains" },
    { "kind": "step", "n": 8, "id": "-", "text": "Release RB: normal speed again, the yellow silhouette refills" },
    { "kind": "check", "id": "shadow-power", "text": "Shadow power: slow motion while RB is held, meter drains and refills" },
    { "kind": "step", "n": 9, "id": "-", "text": "Go to the rock channel (Felsrinne) wall, hold RB and press A at the wall" },
    { "kind": "check", "id": "wall-run", "text": "Wall run: Lara runs along the wall, no crash, no box" },
    { "kind": "step", "n": 10, "id": "-", "text": "Take a hit or fall from a small height: the health bar drops" },
    { "kind": "check", "id": "no-crash", "text": "No crash, freeze or box during the whole run (incl. hit / fall)" },
    { "kind": "step", "n": 11, "id": "-", "text": "Mark the checks (A ok, X fail, Y skip), then end the game normally" }
  ],
  "expects": [
    { "id": "dlc2-costume", "file": "TruDlc2Player.log", "mode": "present",
      "pattern": "level load \\d+: costume \"lara_doppelganger\" -> doppelganger_casual",
      "text": "TruDlc2Player swapped the costume at a level load: lara_doppelganger -> doppelganger_casual" },
    { "id": "dlc2-init", "file": "TruDlc2Player.log", "mode": "present",
      "pattern": "DoppelgangerInit finished \\(instance 0x[0-9a-f]{8}\\)",
      "text": "TruDlc2Player: DoppelgangerInit of the type record ran to its end" },
    { "id": "doppel-ids", "file": "TruDoppelganger.log", "mode": "present",
      "pattern": "title-update ids registered: 13 conditions, 9 activities, 8 states",
      "text": "TruDoppelganger registered all title-update ids (13 conditions, 9 activities, 8 states)" },
    { "id": "sp-loaded", "file": "TruShadowPower.log", "mode": "present",
      "pattern": "TruShadowPower 0\\.5(\\.\\d+)? loaded \\(enabled 1",
      "text": "TruShadowPower 0.5.x loaded and enabled" },
    { "id": "sp-conditions", "file": "TruShadowPower.log", "mode": "present",
      "pattern": "Lara conditions: 1049-1054 \\(meter compare\\).* added to the link array",
      "text": "Lara conditions 1049-1056 added (fails when the sp-conditions switch is off)" },
    { "id": "sp-states", "file": "TruShadowPower.log", "mode": "present",
      "pattern": "Lara states: 243 \\(.*\\) added",
      "text": "Lara states 243 / 245 / 1018 added (fails when the sp-states switch is off)" },
    { "id": "sp-on", "file": "TruShadowPower.log", "mode": "present", "min": 1,
      "pattern": "shadow power ON \\(meter",
      "text": "Shadow power started at least once (RB held; needs LogLevel 2)" },
    { "id": "sp-off", "file": "TruShadowPower.log", "mode": "present", "min": 1,
      "pattern": "shadow power OFF \\(",
      "text": "Shadow power stopped at least once (RB released or meter empty; needs LogLevel 2)" },
    { "id": "sp-no-mismatch", "file": "TruShadowPower.log", "mode": "absent",
      "pattern": "does not match",
      "text": "TruShadowPower found every code site it patches (no 'does not match')" },
    { "id": "rv-patched", "file": "TruRockVein.log", "mode": "present",
      "pattern": "jump table patched: 607 -> 0x[0-9a-f]{8} \\(type -?\\d+\\), 608 -> 0x[0-9a-f]{8}",
      "text": "TruRockVein patched the condition jump table for 607 / 608" },
    { "id": "rv-607", "file": "TruRockVein.log", "mode": "present", "optional": true,
      "pattern": "condition 607 is now evaluated",
      "text": "Wall-run target: condition 607 evaluated at the rock channel (may still fail)" },
    { "id": "rv-608", "file": "TruRockVein.log", "mode": "present", "optional": true,
      "pattern": "condition 608 is now evaluated",
      "text": "Wall-run target: condition 608 evaluated at the rock channel (may still fail)" },
    { "id": "cdb-d3dfail", "file": "cdb.log", "mode": "absent",
      "pattern": "^\\s*D3DFAIL\\s*$",
      "text": "No D3D error handler call (D3DFAIL marker)" },
    { "id": "cdb-av", "file": "cdb.log", "mode": "absent",
      "pattern": "^\\s*AV2NDCHANCE\\s*$",
      "text": "No second-chance access violation (AV2NDCHANCE marker)" },
    { "id": "cdb-fastfail", "file": "cdb.log", "mode": "absent",
      "pattern": "^\\s*FASTFAIL\\s*$",
      "text": "No fast fail (FASTFAIL marker)" },
    { "id": "cdb-msgbox", "file": "cdb.log", "mode": "absent",
